# --- Public (browser) ---
NEXT_PUBLIC_WC_PROJECT_ID=            # https://cloud.walletconnect.com
NEXT_PUBLIC_HOOD_TOKEN_ADDRESS=       # $HOOD ERC-20 contract on Robinhood Chain (id 4663)
NEXT_PUBLIC_HOOD_DECIMALS=18
NEXT_PUBLIC_TREASURY_ADDRESS=         # wallet that receives $HOOD fees
NEXT_PUBLIC_RPC_URL=                  # optional, defaults to public Robinhood Chain RPC
NEXT_PUBLIC_SWAP_URL=                 # optional DEX link, {ca} = token address; empty = explorer link
NEXT_PUBLIC_ROOT_DOMAIN=tokenhood.online

# --- Server only ---
RPC_URL=                              # optional, server-side RPC for payment verification
SUPABASE_URL=                         # optional; without it pages are kept in memory (not persistent!)
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
NEXT_PUBLIC_ADMIN_ADDRESSES=          # comma-separated wallets that publish free (no $HOOD fee)
